{
  "indexes": [
    {
      "//": "Undo-batch lookup: questions written by one generation run.",
      "collectionGroup": "questions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "batch_id", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Daily leaderboard scores: best score first, fastest time wins ties (leaderboard/{date}/scores).",
      "collectionGroup": "scores",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "score", "order": "DESCENDING" },
        { "fieldPath": "time_seconds", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Admin audit trail for one chapter, newest first.",
      "collectionGroup": "admin_audit_logs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "chapter_id", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
