rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // Helper functions
    // ================================================================
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ================================================================
    // Users
    // ================================================================
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(uid);
    }

    match /users/{uid}/meta/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(uid);
    }

    match /users/{uid}/gifts/{giftId} {
      allow read: if isSignedIn() && isOwner(uid);
      allow write: if isSignedIn() && isOwner(uid);
    }

    // ================================================================
    // Online Users (Presence)
    // ================================================================
    match /online_users/{uid} {
      // Anyone signed in can read the online list
      allow read: if isSignedIn();
      // Only the owner can write their own presence
      allow create, update, delete: if isSignedIn() && isOwner(uid);
    }

    // ================================================================
    // Battle Challenges
    // ================================================================
    match /battle_challenges/{challengeId} {
      // Both sender and receiver can read their challenges
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.from_uid ||
         request.auth.uid == resource.data.to_uid);

      // Can create a challenge if signed in and you're the sender
      allow create: if isSignedIn() &&
        request.resource.data.from_uid == request.auth.uid;

      // Can update only if you're the receiver (accept/reject) or sender (cancel)
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.from_uid ||
         request.auth.uid == resource.data.to_uid);

      // Delete: only the involved users
      allow delete: if isSignedIn() &&
        (resource.data.from_uid == request.auth.uid ||
         resource.data.to_uid == request.auth.uid);
    }

    // ================================================================
    // Battle Queue (existing)
    // ================================================================
    match /battle_queue/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isOwner(uid);
      allow delete: if isSignedIn() && isOwner(uid);
    }

    // ================================================================
    // Battle Rooms (existing)
    // ================================================================
    match /battle_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Only players in the room can update it
      allow update: if isSignedIn() &&
        (resource.data.players.a.uid == request.auth.uid ||
         resource.data.players.b.uid == request.auth.uid);
    }

    // ================================================================
    // Leaderboard (existing)
    // ================================================================
    match /leaderboard/{date}/scores/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(uid);
    }

    // ================================================================
    // Champions (existing)
    // ================================================================
    match /champions/{date} {
      allow read: if isSignedIn();
      allow write: if false; // Admin only — handled by admin tooling
    }

    match /champions/{date}/winners/{uid} {
      allow read: if isSignedIn();
      allow write: if false; // Admin only
    }

    // ================================================================
    // Config (existing)
    // ================================================================
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if false; // Admin only
    }
  }
}
